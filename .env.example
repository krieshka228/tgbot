# Telegram
BOT_TOKEN=
# Max (используется для загрузки фото/видео и публикации)
MAX_BOT_TOKEN=
ADMIN_USER_ID=
ADMIN_CHAT_ID=
CHANNEL_ID=
DISCUSSION_GROUP_ID=
# Только для второго бота, который публикует товары в целевой канал
# TARGET_CHANNEL_ID=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# Общее
LOG_LEVEL=INFO
LOG_JSON=false
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=10.0
TG_PROXY=http://127.0.0.1:8080

# Google Sheets (опционально)
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=/app/secrets/credentials.json
GSHEETS_TAB_ORDERS=Опт
GSHEETS_TAB_REF=Справочник
GSHEETS_SYNC_INTERVAL_MINUTES=5
GSHEETS_ENABLED=false
